  } else {
    document.getElementById('mirrorDone').classList.remove('active');
    document.getElementById(`stageCard${mirrorState.stage}`).classList.add('active');
    mirrorState.currentQ = 0;
    document.getElementById('mirrorTest').classList.add('active');
    renderMirrorTestHeader();
