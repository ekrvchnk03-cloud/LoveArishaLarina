    const card = document.createElement('div');
    card.className = 'category-card';
    card.innerHTML = `
      <span class="category-emoji">${cat.emoji}</span>
      <div class="category-name">${cat.name}</div>
      <div class="category-count">${cat.questions.length} вопросов</div>
    `;
    card.onclick = () => startQuiz(key);
    grid.appendChild(card);
  });
}

function startQuiz(categoryKey) {
  quizState = {
    category: categoryKey, currentQ: 0,
    totalQ: quizCategories[categoryKey].questions.length,
    phase: 'boy-self', boyScore: 0, girlScore: 0, answers: {}
  };
  document.getElementById('quizIntro').style.display = 'none';
  document.getElementById('quizGame').classList.add('active');
  document.getElementById('finalScreen').classList.remove('active');
  document.getElementById('totalQ').textContent = quizState.totalQ;
  renderQuestion();
}

function renderQuestion() {
  const cat = quizCategories[quizState.category];
  const question = cat.questions[quizState.currentQ];
  document.getElementById('currentQ').textContent = quizState.currentQ + 1;
  document.getElementById('progressFill').style.width = ((quizState.currentQ + 1) / quizState.totalQ * 100) + '%';
  document.getElementById('boyScore').textContent = quizState.boyScore;
  document.getElementById('girlScore').textContent = quizState.girlScore;
  document.getElementById('questionText').textContent = question.q;
  document.getElementById('resultBlock').classList.remove('active');
  document.querySelector('#quizGame .question-block').style.display = 'block';
  updateTurnIndicator();
  renderQuizAnswers(question.a);
}

function updateTurnIndicator() {
  const ind = document.getElementById('turnIndicator');
  const phase = quizState.phase;
  if (phase === 'boy-self') {
    ind.className = 'turn-indicator boy';
    ind.innerHTML = '🤴 <b>Егор</b>, выбери СВОЙ ответ';
  } else if (phase === 'boy-guess') {
    ind.className = 'turn-indicator boy';
    ind.innerHTML = '🤴 <b>Егор</b>, угадай, что выберет Ариша';
  } else if (phase === 'girl-self') {
    ind.className = 'turn-indicator girl';
    ind.innerHTML = '👸 <b>Ариша</b>, выбери СВОЙ ответ';
  } else if (phase === 'girl-guess') {
    ind.className = 'turn-indicator girl';
    ind.innerHTML = '👸 <b>Ариша</b>, угадай, что выберет Егор';
  }
}

function renderQuizAnswers(answers) {
  const grid = document.getElementById('answersGrid');
  grid.innerHTML = '';
  answers.forEach((ans, i) => {
    const btn = document.createElement('button');
    btn.className = 'quiz-answer';
    btn.textContent = ans;
    btn.onclick = () => handleQuizAnswer(i, ans);
    grid.appendChild(btn);
  });
}

function handleQuizAnswer(index, text) {
  const phase = quizState.phase;
  if (phase === 'boy-self') {
    quizState.answers.boySelf = { index, text };
    quizState.phase = 'boy-guess';
  } else if (phase === 'boy-guess') {
    quizState.answers.boyGuess = { index, text };
    quizState.phase = 'girl-self';
  } else if (phase === 'girl-self') {
    quizState.answers.girlSelf = { index, text };
    quizState.phase = 'girl-guess';
  } else if (phase === 'girl-guess') {
    quizState.answers.girlGuess = { index, text };
    setTimeout(showRoundResult, 400);
    return;
  }
  document.querySelectorAll('#answersGrid .quiz-answer').forEach(b => b.disabled = true);
  setTimeout(() => {
    const cat = quizCategories[quizState.category];
    renderQuizAnswers(cat.questions[quizState.currentQ].a);
    updateTurnIndicator();
  }, 500);
}

function showRoundResult() {
  document.querySelector('#quizGame .question-block').style.display = 'none';
  const { boySelf, boyGuess, girlSelf, girlGuess } = quizState.answers;
  const boyGuessedRight = boyGuess.index === girlSelf.index;
  const girlGuessedRight = girlGuess.index === boySelf.index;
  if (boyGuessedRight) quizState.boyScore++;
  if (girlGuessedRight) quizState.girlScore++;
  document.getElementById('resultComparison').innerHTML = `
    <div class="result-side boy">
      <h4>🤴 Егор</h4>
      <div class="label">Его выбор</div>
      <div class="own-answer">${boySelf.text}</div>
      <div class="label">Его догадка про Аришу</div>
      <div class="guess-answer ${boyGuessedRight ? 'guessed-correct' : 'guessed-wrong'}">
        ${boyGuess.text} ${boyGuessedRight ? '✓' : '✗'}
      </div>
    </div>
    <div class="result-side girl">
      <h4>👸 Ариша</h4>
      <div class="label">Её выбор</div>
      <div class="own-answer">${girlSelf.text}</div>
      <div class="label">Её догадка про Егора</div>
      <div class="guess-answer ${girlGuessedRight ? 'guessed-correct' : 'guessed-wrong'}">
        ${girlGuess.text} ${girlGuessedRight ? '✓' : '✗'}
      </div>
    </div>
  `;
  let msg = '';
  if (boyGuessedRight && girlGuessedRight) msg = '🎉 Оба угадали! +1 балл каждому';
  else if (boyGuessedRight) msg = '💙 Егор угадал! +1 балл';
  else if (girlGuessedRight) msg = '💖 Ариша угадала! +1 балл';
  else msg = '🤷 В этот раз никто не угадал';
  document.getElementById('pointsGained').textContent = msg;
  document.getElementById('boyScore').textContent = quizState.boyScore;
  document.getElementById('girlScore').textContent = quizState.girlScore;
  document.getElementById('resultBlock').classList.add('active');
}

document.getElementById('nextBtn').onclick = () => {
  quizState.currentQ++;
  quizState.answers = {};
  quizState.phase = 'boy-self';
  if (quizState.currentQ >= quizState.totalQ) showFinalScreen();
  else renderQuestion();
};

function showFinalScreen() {
  document.getElementById('quizGame').classList.remove('active');
  document.getElementById('finalScreen').classList.add('active');
  document.getElementById('boyFinalScore').textContent = quizState.boyScore;
  document.getElementById('girlFinalScore').textContent = quizState.girlScore;
  const winnerEl = document.getElementById('finalWinner');
  const emojiEl = document.getElementById('finalEmoji');
  const msgEl = document.getElementById('finalMessage');
  if (quizState.boyScore > quizState.girlScore) {
    winnerEl.textContent = 'Егор побеждает! 🏆';
    emojiEl.textContent = '🤴';
    msgEl.textContent = 'Он знает Аришу как самого себя!';
  } else if (quizState.girlScore > quizState.boyScore) {
    winnerEl.textContent = 'Ариша побеждает! 🏆';
    emojiEl.textContent = '👸';
    msgEl.textContent = 'Она знает Егора лучше всех!';
  } else {
    winnerEl.textContent = 'Ничья! 💞';
    emojiEl.textContent = '💕';
    msgEl.textContent = 'Вы знаете друг друга одинаково хорошо!';
  }
}

function resetQuiz() {
  document.getElementById('finalScreen').classList.remove('active');
  document.getElementById('quizIntro').style.display = 'block';
}

initQuizCategories();

document.getElementById('modal').addEventListener('click', e => {
  if (e.target.id === 'modal') closeModal();
});
</script>
</body>
</html>
