<!DOCTYPE html>
<html lang="ru">
<headскопируй>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Наш мир 💖</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --pink-light: #ffe4ec;
    --pink-medium: #ffb6c8;
    --pink-deep: #e91e63;
    --pink-dark: #ad1457;
    --blue-soft: #b3d9ff;
    --blue-deep: #2196f3;
    --gold: #d4a574;
    --cream: #fff8f3;
    --text-dark: #4a2c3a;
    --text-light: #8b5a6b;
    --shadow-soft: 0 8px 32px rgba(233, 30, 99, 0.12);
    --shadow-hover: 0 12px 48px rgba(233, 30, 99, 0.2);
  }

  * { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Montserrat', sans-serif;
    background: linear-gradient(135deg, #fff0f5 0%, #ffe4ec 50%, #ffd6e0 100%);
    min-height: 100vh;
    color: var(--text-dark);
    overflow-x: hidden;
    position: relative;
  }

  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 182, 200, 0.4) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 192, 203, 0.3) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  /* GPU-ускорение для анимаций */
  .heart-particle,
  .logo-icon,
  .tab-btn,
  .btn-primary,
  .feature-card,
  .memory-card,
  .answer-btn,
  .category-card {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  .hearts-bg { 
    position: fixed; 
    top: 0; left: 0; 
    width: 100%; 
    height: 100%; 
    pointer-events: none; 
    z-index: 1; 
    overflow: hidden;
  }
  
  .heart-particle {
    position: absolute;
    bottom: -50px;
    opacity: 0;
    animation: floatUp 10s linear forwards;
  }
  
  @keyframes floatUp {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
      opacity: 0;
    }
    10% { opacity: 0.5; }
    50% {
      transform: translate3d(20px, -50vh, 0) rotate(180deg);
      opacity: 0.7;
    }
    90% { opacity: 0.4; }
    100% {
      transform: translate3d(-20px, -110vh, 0) rotate(360deg);
      opacity: 0;
    }
  }

  .container { 
    max-width: 1200px; 
    margin: 0 auto; 
    padding: 0 24px; 
    position: relative; 
    z-index: 2; 
  }

  header { 
    text-align: center; 
    padding: 60px 24px 40px; 
    position: relative; 
    z-index: 2; 
  }
  
  .logo-icon { 
    font-size: 2.5em; 
    animation: pulse 2.5s ease-in-out infinite; 
    display: inline-block; 
    margin-bottom: 16px; 
  }
  
  @keyframes pulse { 
    0%, 100% { transform: scale(1); } 
    50% { transform: scale(1.12); } 
  }

  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2em, 5vw, 3.5em);
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 12px;
    background: linear-gradient(135deg, #e91e63, #ad1457);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .subtitle { 
    font-size: clamp(0.9em, 2vw, 1.1em); 
    color: var(--text-light); 
    font-weight: 300; 
    letter-spacing: 2px; 
    text-transform: uppercase; 
  }

  nav {
    position: sticky; 
    top: 16px; 
    z-index: 100;
    margin: 0 auto 40px;
    max-width: fit-content;
    padding: 8px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 50px;
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(255, 255, 255, 0.6);
    display: flex; 
    flex-wrap: wrap; 
    gap: 4px; 
    justify-content: center;
  }
  
  .tab-btn {
    padding: 12px 22px; 
    border: none; 
    border-radius: 40px;
    background: transparent; 
    color: var(--text-light);
    font-size: 0.9em; 
    font-weight: 500; 
    cursor: pointer;
    transition: color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    font-family: inherit; 
    white-space: nowrap;
  }
  
  .tab-btn:hover { 
    color: var(--pink-deep); 
    background: rgba(255, 182, 200, 0.3); 
  }
  
  .tab-btn.active {
    background: linear-gradient(135deg, var(--pink-deep), var(--pink-dark));
    color: white;
    box-shadow: 0 4px 16px rgba(233, 30, 99, 0.4);
  }

  .tab { 
    display: none; 
    animation: fadeUp 0.6s cubic-bezier(0.4, 0, 0.2, 1); 
  }
  .tab.active { display: block; }
  
  @keyframes fadeUp { 
    from { opacity: 0; transform: translateY(30px); } 
    to { opacity: 1; transform: translateY(0); } 
  }

  .card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 28px;
    padding: clamp(24px, 4vw, 48px);
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(255, 255, 255, 0.6);
    margin-bottom: 24px;
  }

  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.6em, 3.5vw, 2.4em);
    font-weight: 600;
    color: var(--pink-dark);
    text-align: center;
    margin-bottom: 24px;
  }

  .hero { text-align: center; padding: 20px 0; }
  .hero-text { 
    font-size: clamp(1em, 2vw, 1.2em); 
    line-height: 1.8; 
    max-width: 600px; 
    margin: 0 auto 32px; 
    font-weight: 300; 
  }

  .hero-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px; 
    margin-top: 40px;
  }
  
  .feature-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(255, 228, 236, 0.6));
    padding: 28px 20px;
    border-radius: 20px;
    text-align: center;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    cursor: pointer;
    border: 1px solid rgba(255, 182, 200, 0.3);
  }
  
  .feature-card:hover { 
    transform: translateY(-6px); 
    box-shadow: var(--shadow-hover); 
  }
  
  .feature-icon { 
    font-size: 2.5em; 
    margin-bottom: 12px; 
    display: block; 
  }
  
  .feature-title { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.3em; 
    color: var(--pink-dark); 
    margin-bottom: 8px; 
    font-weight: 600; 
  }
  
  .feature-desc { 
    font-size: 0.9em; 
    color: var(--text-light); 
    line-height: 1.5; 
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--pink-deep), var(--pink-dark));
    color: white;
    padding: 14px 36px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    font-size: 1em;
    font-weight: 500;
    font-family: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(233, 30, 99, 0.3);
    letter-spacing: 0.5px;
  }
  
  .btn-primary:hover { 
    transform: translateY(-2px); 
    box-shadow: 0 8px 24px rgba(233, 30, 99, 0.4); 
  }
  
  .btn-primary:disabled { 
    opacity: 0.4; 
    cursor: not-allowed; 
    transform: none; 
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.8);
    color: var(--pink-dark);
    padding: 12px 28px;
    border: 2px solid var(--pink-medium);
    border-radius: 50px;
    cursor: pointer;
    font-size: 0.95em;
    font-weight: 500;
    font-family: inherit;
    transition: background 0.3s ease;
  }
  
  .btn-secondary:hover { background: var(--pink-light); }

  /* ===== ЗЕРКАЛО ДУШИ ===== */
  .mirror-intro { text-align: center; padding: 20px 0; }

  .mirror-stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin: 30px 0;
  }

  .stage-card {
    background: rgba(255, 255, 255, 0.7);
    padding: 20px 16px;
    border-radius: 18px;
    text-align: center;
    border: 2px solid transparent;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    position: relative;
  }
  
  .stage-card.done {
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    border-color: #66bb6a;
  }
  
  .stage-card.active {
    border-color: var(--pink-deep);
    transform: scale(1.03);
    box-shadow: var(--shadow-soft);
  }
  
  .stage-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8em;
    font-weight: 700;
    color: var(--pink-deep);
  }
  
  .stage-card.done .stage-num { color: #2e7d32; }
  .stage-name { font-size: 0.9em; margin-top: 6px; }
  
  .stage-check { 
    position: absolute; 
    top: 8px; right: 8px;
    font-size: 1.2em;
    display: none;
  }
  
  .stage-card.done .stage-check { display: block; }

  .start-section {
    text-align: center;
    margin: 30px 0;
    padding: 30px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 20px;
  }
  
  .start-section h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6em;
    color: var(--pink-dark);
    margin-bottom: 12px;
  }
  
  .start-section p {
    color: var(--text-light);
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .mirror-test { display: none; }
  .mirror-test.active { display: block; }

  .test-header {
    text-align: center;
    margin-bottom: 24px;
    padding: 20px;
    border-radius: 18px;
  }
  
  .test-header.boy {
    background: linear-gradient(135deg, rgba(33, 150, 243, 0.15), rgba(179, 217, 255, 0.3));
    border: 2px solid var(--blue-soft);
  }
  
  .test-header.girl {
    background: linear-gradient(135deg, rgba(233, 30, 99, 0.1), rgba(255, 228, 236, 0.5));
    border: 2px solid var(--pink-medium);
  }
  
  .test-emoji { font-size: 3em; margin-bottom: 8px; }
  
  .test-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5em, 3vw, 2em);
    font-weight: 600;
    margin-bottom: 6px;
  }
  
  .test-header.boy .test-title { color: var(--blue-deep); }
  .test-header.girl .test-title { color: var(--pink-deep); }
  .test-subtitle { font-size: 0.95em; color: var(--text-light); }

  .test-progress {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  
  .test-progress-text {
    font-size: 0.95em;
    color: var(--text-light);
    white-space: nowrap;
  }
  
  .progress-bar {
    flex: 1;
    min-width: 200px;
    height: 10px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    overflow: hidden;
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--pink-deep), var(--pink-dark));
    transition: width 0.4s ease;
    border-radius: 10px;
  }

  .question-block {
    background: rgba(255, 255, 255, 0.85);
    padding: clamp(20px, 4vw, 32px);
    border-radius: 24px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 182, 200, 0.3);
  }
  
  .question-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.3em, 2.5vw, 1.7em);
    text-align: center;
    color: var(--pink-dark);
    margin-bottom: 24px;
    line-height: 1.4;
  }
  
  .answers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  
  .answer-btn {
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.8);
    border: 2px solid rgba(255, 182, 200, 0.3);
    border-radius: 14px;
    cursor: pointer;
    font-size: 0.98em;
    font-family: inherit;
    color: var(--text-dark);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    text-align: left;
  }
  
  .answer-btn:hover {
    background: rgba(255, 228, 236, 0.8);
    border-color: var(--pink-medium);
    transform: translateY(-2px);
  }
  
  .answer-btn.boy-mode:hover { 
    border-color: var(--blue-deep); 
    background: rgba(179, 217, 255, 0.4); 
  }

  .done-screen {
    display: none;
    text-align: center;
    padding: 30px 0;
  }
  
  .done-screen.active { display: block; animation: fadeUp 0.6s; }
  .done-emoji { font-size: 5em; margin-bottom: 16px; animation: pulse 2s infinite; }
  
  .done-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8em, 4vw, 2.5em);
    color: var(--pink-deep);
    margin-bottom: 12px;
  }
  
  .done-text {
    font-size: 1.05em;
    color: var(--text-light);
    line-height: 1.7;
    max-width: 500px;
    margin: 0 auto 28px;
  }

  .final-results { display: none; }
  .final-results.active { display: block; animation: fadeUp 0.6s; }

  .results-summary {
    background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,228,236,0.7));
    padding: clamp(24px, 4vw, 36px);
    border-radius: 24px;
    text-align: center;
    margin-bottom: 24px;
    border: 2px solid var(--pink-medium);
  }
  
  .results-summary h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.6em, 3vw, 2em);
    color: var(--pink-dark);
    margin-bottom: 16px;
  }

  .match-percentage {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3em, 8vw, 5em);
    font-weight: 700;
    background: linear-gradient(135deg, var(--pink-deep), var(--pink-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin: 16px 0;
  }
  
  .match-label { 
    font-size: 1em; 
    color: var(--text-light); 
    letter-spacing: 1px; 
    text-transform: uppercase; 
  }

  .guess-results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin: 24px 0;
  }

  .guess-card {
    background: rgba(255, 255, 255, 0.9);
    padding: 24px;
    border-radius: 20px;
    text-align: center;
    border: 2px solid;
  }
  
  .guess-card.boy { border-color: var(--blue-soft); }
  .guess-card.girl { border-color: var(--pink-medium); }
  
  .guess-card h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4em;
    margin-bottom: 12px;
  }
  
  .guess-card.boy h4 { color: var(--blue-deep); }
  .guess-card.girl h4 { color: var(--pink-deep); }
  
  .guess-card .score-big {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3em;
    font-weight: 700;
    margin: 8px 0;
  }
  
  .guess-card.boy .score-big { color: var(--blue-deep); }
  .guess-card.girl .score-big { color: var(--pink-deep); }
  .guess-card .score-detail { color: var(--text-light); font-size: 0.95em; }

  .details-toggle { text-align: center; margin: 20px 0; }
  
  .details-list { display: none; margin-top: 20px; }
  .details-list.active { display: block; }
  
  .detail-item {
    background: rgba(255, 255, 255, 0.7);
    padding: 16px;
    border-radius: 14px;
    margin-bottom: 10px;
    text-align: left;
  }
  
  .detail-item .q-text { 
    font-weight: 600; 
    color: var(--pink-dark); 
    margin-bottom: 8px; 
  }
  
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px dashed rgba(0,0,0,0.05);
    flex-wrap: wrap;
    gap: 8px;
  }
  
  .detail-row:last-child { border-bottom: none; }
  .detail-row .label { font-size: 0.85em; color: var(--text-light); }
  .detail-row .ans { font-size: 0.95em; }
  .detail-row .match-yes { color: #2e7d32; font-weight: 600; }
  .detail-row .match-no { color: #c62828; }

  /* === Memory === */
  #memory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(8px, 1.5vw, 14px);
    max-width: 480px;
    margin: 0 auto 24px;
  }
  
  .memory-card {
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--pink-deep), var(--pink-dark));
    border-radius: 14px;
    display: flex; 
    align-items: center; 
    justify-content: center;
    font-size: clamp(1.6em, 5vw, 2.2em);
    cursor: pointer; 
    color: transparent;
    transition: transform 0.4s ease, background 0.4s ease;
    box-shadow: 0 4px 12px rgba(233, 30, 99, 0.2);
    user-select: none;
  }
  
  .memory-card::before { 
    content: '💝'; 
    color: white; 
    font-size: 1.4em; 
    transition: opacity 0.3s; 
  }
  
  .memory-card:hover:not(.flipped):not(.matched) { 
    transform: translateY(-4px) scale(1.03); 
  }
  
  .memory-card.flipped { 
    background: white; 
    color: initial; 
  }
  
  .memory-card.flipped::before { opacity: 0; display: none; }
  
  .memory-card.matched {
    background: linear-gradient(135deg, #ffd6e0, #ffb6c8);
    color: initial; 
    cursor: default;
    animation: matched 0.6s ease;
  }
  
  .memory-card.matched::before { opacity: 0; display: none; }
  
  @keyframes matched { 
    0%, 100% { transform: scale(1); } 
    50% { transform: scale(1.1); } 
  }

  .game-header {
    display: flex; 
    justify-content: space-between; 
    align-items: center;
    flex-wrap: wrap; 
    gap: 16px;
    margin-bottom: 20px; 
    padding: 16px 24px;
    background: rgba(255, 255, 255, 0.6); 
    border-radius: 16px;
  }
  
  .score-box { display: flex; gap: 24px; align-items: center; }
  .score-item { font-size: 1em; color: var(--text-light); }
  .score-value { font-size: 1.4em; font-weight: 600; color: var(--pink-deep); }

  /* === Две половинки === */
  .quiz-intro { text-align: center; padding: 20px 0; }
  
  .players-setup {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px; 
    margin: 30px 0;
  }
  
  .player-card {
    background: rgba(255, 255, 255, 0.7);
    padding: 24px;
    border-radius: 20px;
    text-align: center;
    border: 2px solid transparent;
  }
  
  .player-card.boy { border-color: var(--blue-soft); }
  .player-card.girl { border-color: var(--pink-medium); }
  .player-emoji { font-size: 3em; margin-bottom: 8px; }
  
  .player-name { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.5em; 
    font-weight: 600; 
  }
  
  .player-card.boy .player-name { color: var(--blue-deep); }
  .player-card.girl .player-name { color: var(--pink-deep); }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px; 
    margin: 30px 0;
  }
  
  .category-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 228, 236, 0.7));
    padding: 24px 16px;
    border-radius: 18px;
    text-align: center; 
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    border: 2px solid transparent;
  }
  
  .category-card:hover {
    transform: translateY(-4px);
    border-color: var(--pink-medium);
    box-shadow: var(--shadow-soft);
  }
  
  .category-emoji { font-size: 2.5em; display: block; margin-bottom: 10px; }
  
  .category-name { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.2em; 
    color: var(--pink-dark); 
    font-weight: 600; 
  }
  
  .category-count { 
    font-size: 0.85em; 
    color: var(--text-light); 
    margin-top: 4px; 
  }

  .quiz-game { display: none; }
  .quiz-game.active { display: block; }
  
  .quiz-progress {
    display: flex; 
    justify-content: space-between; 
    align-items: center;
    margin-bottom: 24px; 
    flex-wrap: wrap; 
    gap: 16px;
  }
  
  .scoreboard {
    display: flex; 
    gap: 12px; 
    justify-content: center;
    margin-bottom: 24px; 
    flex-wrap: wrap;
  }
  
  .score-card {
    flex: 1; 
    min-width: 140px;
    padding: 16px; 
    border-radius: 16px;
    text-align: center;
    background: rgba(255, 255, 255, 0.8);
    border: 2px solid transparent;
  }
  
  .score-card.boy { border-color: var(--blue-soft); }
  .score-card.girl { border-color: var(--pink-medium); }
  .score-card .name { font-size: 0.9em; color: var(--text-light); }
  
  .score-card .points { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 2.2em; 
    font-weight: 700; 
  }
  
  .score-card.boy .points { color: var(--blue-deep); }
  .score-card.girl .points { color: var(--pink-deep); }

  .turn-indicator {
    text-align: center;
    padding: 14px 20px;
    border-radius: 14px;
    margin-bottom: 20px;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  
  .turn-indicator.boy {
    background: linear-gradient(135deg, rgba(33, 150, 243, 0.15), rgba(179, 217, 255, 0.4));
    color: var(--blue-deep);
    border: 2px solid var(--blue-soft);
  }
  
  .turn-indicator.girl {
    background: linear-gradient(135deg, rgba(233, 30, 99, 0.1), rgba(255, 228, 236, 0.6));
    color: var(--pink-deep);
    border: 2px solid var(--pink-medium);
  }

  .quiz-answer {
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.7);
    border: 2px solid rgba(255, 182, 200, 0.3);
    border-radius: 14px;
    cursor: pointer; 
    font-size: 0.98em;
    font-family: inherit; 
    color: var(--text-dark);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    text-align: left;
  }
  
  .quiz-answer:hover:not(:disabled) {
    background: rgba(255, 228, 236, 0.8);
    border-color: var(--pink-medium);
    transform: translateY(-2px);
  }
  
  .quiz-answer:disabled { cursor: not-allowed; opacity: 0.7; }

  .result-block {
    display: none;
    background: rgba(255, 255, 255, 0.9);
    padding: clamp(20px, 4vw, 32px);
    border-radius: 24px; 
    margin-bottom: 20px;
    text-align: center;
  }
  
  .result-block.active { display: block; animation: fadeUp 0.5s; }
  
  .result-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px; 
    margin: 24px 0;
  }
  
  .result-side {
    padding: 20px; 
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.6);
  }
  
  .result-side.boy { border: 2px solid var(--blue-soft); }
  .result-side.girl { border: 2px solid var(--pink-medium); }
  
  .result-side h4 { 
    font-family: 'Cormorant Garamond', serif; 
    margin-bottom: 12px; 
    font-size: 1.3em; 
  }
  
  .result-side.boy h4 { color: var(--blue-deep); }
  .result-side.girl h4 { color: var(--pink-deep); }
  
  .result-side .own-answer, .result-side .guess-answer {
    padding: 10px 14px; 
    background: white;
    border-radius: 10px; 
    margin: 8px 0; 
    font-size: 0.95em;
  }
  
  .result-side .label { 
    font-size: 0.8em; 
    color: var(--text-light); 
    text-transform: uppercase; 
    letter-spacing: 1px; 
  }
  
  .result-side .guessed-correct { 
    background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
    font-weight: 600; 
    color: #1b5e20;
  }
  
  .result-side .guessed-wrong {
    background: linear-gradient(135deg, #ffcdd2, #ef9a9a);
    color: #b71c1c;
  }
  
  .points-gained {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3em; 
    color: var(--pink-deep); 
    margin: 16px 0;
  }
  
  .final-screen { display: none; text-align: center; padding: 30px 0; }
  .final-screen.active { display: block; animation: fadeUp 0.6s; }
  
  .final-winner { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: clamp(2em, 5vw, 3em); 
    color: var(--pink-deep); 
    margin: 20px 0; 
  }
  
  .final-scores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px; 
    max-width: 500px; 
    margin: 30px auto;
  }

  /* Письмо */
  .love-letter {
    background: linear-gradient(135deg, #fff8f3, #fff0e5);
    padding: clamp(28px, 5vw, 48px);
    border-radius: 20px;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.1em, 2vw, 1.3em);
    line-height: 2;
    color: var(--text-dark);
    box-shadow: inset 0 0 0 1px rgba(233, 30, 99, 0.1);
    position: relative;
  }
  
  .love-letter::before {
    content: '💌';
    position: absolute; 
    top: -20px; 
    left: 50%;
    transform: translateX(-50%);
    font-size: 2.5em;
    background: white;
    width: 60px; 
    height: 60px;
    border-radius: 50%;
    display: flex; 
    align-items: center; 
    justify-content: center;
    box-shadow: var(--shadow-soft);
  }
  
  .signature { 
    display: block; 
    text-align: right; 
    margin-top: 20px; 
    font-style: italic; 
    color: var(--pink-deep); 
  }

  .modal {
    display: none; 
    position: fixed; 
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    z-index: 1000; 
    align-items: center; 
    justify-content: center;
    padding: 20px;
  }
  
  .modal.active { display: flex; animation: fadeUp 0.4s; }
  
  .modal-content {
    background: white;
    padding: 40px 32px;
    border-radius: 24px;
    text-align: center;
    max-width: 400px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  }
  
  .modal-content .emoji { 
    font-size: 4em; 
    margin-bottom: 16px; 
    animation: pulse 1.5s infinite; 
  }

  @media (max-width: 768px) {
    header { padding: 40px 16px 24px; }
    nav { margin: 0 16px 24px; padding: 6px; position: relative; top: 0; }
    .tab-btn { padding: 10px 16px; font-size: 0.85em; }
    .container { padding: 0 16px; }
  }
  
  @media (max-width: 480px) {
    .answers-grid { grid-template-columns: 1fr; }
    .game-header { flex-direction: column; text-align: center; }
  }

  ::-webkit-scrollbar { width: 10px; }
  ::-webkit-scrollbar-track { background: var(--pink-light); }
  ::-webkit-scrollbar-thumb { 
    background: var(--pink-medium); 
    border-radius: 10px; 
  }
  ::-webkit-scrollbar-thumb:hover { 
    background: ink-deep); 
  }
</style>
</head>
<body>

<div class="hearts-bg" id="heartsBg"></div>

<header>
