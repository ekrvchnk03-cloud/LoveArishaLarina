};

document.getElementById('startBtn').addEventListener('click', startMirrorStage);

function startMirrorStage() {
  document.getElementById('mirrorIntro').style.display = 'none';
  document.getElementById('mirrorTest').classList.add('active');
  document.getElementById('mirrorDone').classList.remove('active');
  mirrorState.currentQ = 0;
  renderMirrorTestHeader();
  renderMirrorQuestion();
}

function renderMirrorTestHeader() {
  const header = document.getElementById('testHeader');
  const emoji = document.getElementById('testEmoji');
  const title = document.getElementById('testTitle');
  const sub = document.getElementById('testSubtitle');

  if (mirrorState.stage === 0) {
    header.className = 'test-header boy';
    emoji.textContent = '🤴';
    title.textContent = 'Тест для Егора';
    sub.textContent = 'Отвечай искренне о себе';
  } else if (mirrorState.stage === 1) {
    header.className = 'test-header girl';
    emoji.textContent = '👸';
    title.textContent = 'Тест для Ариши';
    sub.textContent = 'Отвечай искренне о себе';
  } else if (mirrorState.stage === 2) {
    header.className = 'test-header boy';
    emoji.textContent = '🤴💭';
    title.textContent = 'Тест: что выберет Ариша?';
    sub.textContent = 'Егор, угадай ответы любимой';
  } else if (mirrorState.stage === 3) {
    header.className = 'test-header girl';
    emoji.textContent = '👸💭';
    title.textContent = 'Тест: что выберет Егор?';
    sub.textContent = 'Ариша, угадай ответы любимого';
  }
}

function renderMirrorQuestion() {
  const q = mirrorQuestions[mirrorState.currentQ];
  document.getElementById('mCurrentQ').textContent = mirrorState.currentQ + 1;
  document.getElementById('mTotalQ').textContent = mirrorQuestions.length;
  document.getElementById('mProgressFill').style.width = ((mirrorState.currentQ + 1) / mirrorQuestions.length * 100) + '%';
  document.getElementById('mQuestionText').textContent = q.q;

  const grid = document.getElementById('mAnswersGrid');
  grid.innerHTML = '';
  const isBoyMode = mirrorState.stage === 0 || mirrorState.stage === 2;
  q.a.forEach((ans, i) => {
    const btn = document.createElement('button');
    btn.className = 'answer-btn' + (isBoyMode ? ' boy-mode' : '');
    btn.textContent = ans;
    btn.onclick = () => handleMirrorAnswer(i);
    grid.appendChild(btn);
  });
}

function handleMirrorAnswer(index) {
  const keys = ['boySelf', 'girlSelf', 'boyGuess', 'girlGuess'];
  mirrorState.answers[keys[mirrorState.stage]].push(index);
  
  mirrorState.currentQ++;
  if (mirrorState.currentQ >= mirrorQuestions.length) {
    finishStage();
  } else {
    renderMirrorQuestion();
  }
}

function finishStage() {
  document.getElementById('mirrorTest').classList.remove('active');
  document.getElementById(`stageCard${mirrorState.stage}`).classList.add('done');
  
  const emoji = document.getElementById('doneEmoji');
  const title = document.getElementById('doneTitle');
  const text = document.getElementById('doneText');
  
  if (mirrorState.stage === 0) {
    emoji.textContent = '🤴✨';
    title.textContent = 'Часть 1 пройдена!';
    text.innerHTML = 'Егор ответил на все вопросы о себе 💙<br>Теперь очередь Ариши рассказать о себе.<br><b>Передай ноутбук любимой 💕</b>';
