function showMirrorResults() {
  document.getElementById('mirrorDone').classList.remove('active');
  document.getElementById('mirrorIntro').style.display = 'none';
  document.getElementById('mirrorResults').classList.add('active');
  document.getElementById(`stageCard4`).classList.add('done');

  const { boySelf, girlSelf, boyGuess, girlGuess } = mirrorState.answers;
  const total = mirrorQuestions.length;

  let matches = 0;
  for (let i = 0; i < total; i++) {
    if (boySelf[i] === girlSelf[i]) matches++;
  }
  const matchPct = Math.round(matches / total * 100);

  let boyGuessed = 0;
  let girlGuessed = 0;
  for (let i = 0; i < total; i++) {
    if (boyGuess[i] === girlSelf[i]) boyGuessed++;
    if (girlGuess[i] === boySelf[i]) girlGuessed++;
  }

  document.getElementById('matchPercent').textContent = matchPct + '%';
  let matchMsg = '';
  if (matchPct >= 70) matchMsg = 'Вы как две капли воды! 💞';
  else if (matchPct >= 50) matchMsg = 'У вас много общего ✨';
  else if (matchPct >= 30) matchMsg = 'Вы дополняете друг друга 💕';
  else matchMsg = 'Противоположности притягиваются! 🌗';
  document.getElementById('matchMessage').textContent = matchMsg;

  document.getElementById('boyGuessScore').textContent = boyGuessed;
  document.getElementById('boyGuessPercent').textContent = Math.round(boyGuessed / total * 100);
  document.getElementById('girlGuessScore').textContent = girlGuessed;
  document.getElementById('girlGuessPercent').textContent = Math.round(girlGuessed / total * 100);

  const winnerText = document.getElementById('winnerText');
  const winnerMsg = document.getElementById('winnerMessage');
  if (boyGuessed > girlGuessed) {
    winnerText.textContent = '🏆 Егор знает Аришу лучше!';
    winnerMsg.textContent = `Угадал на ${boyGuessed - girlGuessed} ответ(ов) больше 💙`;
  } else if (girlGuessed > boyGuessed) {
    winnerText.textContent = '🏆 Ариша знает Егора лучше!';
    winnerMsg.textContent = `Угадала на ${girlGuessed - boyGuessed} ответ(ов) больше 💖`;
  } else {
    winnerText.textContent = '💞 Идеальная ничья!';
    winnerMsg.textContent = 'Вы знаете друг друга одинаково хорошо ✨';
  }

  const list = document.getElementById('detailsList');
  list.innerHTML = '';
  mirrorQuestions.forEach((q, i) => {
    const item = document.createElement('div');
    item.className = 'detail-item';
    const sameAnswer = boySelf[i] === girlSelf[i];
    const boyOk = boyGuess[i] === girlSelf[i];
    const girlOk = girlGuess[i] === boySelf[i];
    item.innerHTML = `
      <div class="q-text">${i + 1}. ${q.q}</div>
      <div class="detail-row">
        <span class="label">Егор о себе:</span>
        <span class="ans">${q.a[boySelf[i]]}</span>
      </div>
      <div class="detail-row">
        <span class="label">Ариша о себе:</span>
        <span class="ans ${sameAnswer ? 'match-yes' : ''}">${q.a[girlSelf[i]]} ${sameAnswer ? '✓ совпало' : ''}</span>
      </div>
      <div class="detail-row">
        <span class="label">Егор про Аришу:</span>
        <span class="ans ${boyOk ? 'match-yes' : 'match-no'}">${q.a[boyGuess[i]]} ${boyOk ? '✓' : '✗'}</span>
      </div>
      <div class="detail-row">
        <span class="label">Ариша про Егора:</span>
        <span class="ans ${girlOk ? 'match-yes' : 'match-no'}">${q.a[girlGuess[i]]} ${girlOk ? '✓' : '✗'}</span>
      </div>
    `;
    list.appendChild(item);
  });
}

